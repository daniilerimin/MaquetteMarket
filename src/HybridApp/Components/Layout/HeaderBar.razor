@* @using Microsoft.AspNetCore.Components.Endpoints *@

<div class="MaquetteMarket-header @(IsCatalog? "home" : "")">
    <div class="MaquetteMarket-header-hero">
        @{
            var headerImage = IsCatalog ? "images/header-home.webp" : "images/header.webp";
        }
        <img src="@headerImage" />
    </div>
    <div class="MaquetteMarket-header-container">
        <nav class="MaquetteMarket-header-navbar">
            <a class="logo logo-header" href="">
                <img src="images/logo-header.svg" class="logo logo-header" />
            </a>
            
@*             <UserMenu />
            <CartMenu />
 *@        </nav>
        <div class="MaquetteMarket-header-intro">
            <h1><SectionOutlet SectionName="page-header-title" /></h1>
            <p><SectionOutlet SectionName="page-header-subtitle" /></p>
        </div>
    </div>
</div>

@code {
    // [CascadingParameter]
